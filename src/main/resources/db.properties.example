# Copy this file to db.properties (same folder) and fill in real values.
# db.properties is gitignored — never commit real credentials.
#
# For a local XAMPP/MariaDB install, the default root password is often blank.
# Leave db.password empty if your server does not require one.
# If no database settings are provided, the application will use an embedded H2 database instead.

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/campuslink_career?useSSL=false&serverTimezone=UTC
db.username=root
db.password=
db.pool.size=10

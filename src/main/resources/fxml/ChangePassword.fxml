<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campuslink.controllers.ChangePasswordController"
            styleClass="login-container">

    <top>
        <VBox styleClass="login-header">
            <Label text="CampusLink Career" styleClass="login-title"/>
            <Label text="Security Update" style="-fx-text-fill: #BBDEFB; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="0">
            <VBox.margin>
                <Insets top="30" bottom="30" left="50" right="50"/>
            </VBox.margin>
            <VBox styleClass="login-card" spacing="14" alignment="TOP_CENTER" maxWidth="380">
                <Label text="Change Password"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212121;"/>
                <Label text="You must change your password before continuing."
                       wrapText="true" style="-fx-text-fill: #757575; -fx-text-alignment: center;"/>
                <Separator/>

                <Label text="Current Password" styleClass="form-label"/>
                <PasswordField fx:id="currentPasswordField" promptText="Enter current password"/>

                <Label text="New Password" styleClass="form-label"/>
                <PasswordField fx:id="newPasswordField" promptText="Enter new strong password"/>

                <Label text="Confirm New Password" styleClass="form-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password"/>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>

                <Button fx:id="submitBtn" text="Update Password" styleClass="btn-primary"
                        onAction="#handleChangePassword" maxWidth="Infinity" defaultButton="true"/>

                <Separator/>
                <Button text="Cancel and Logout" onAction="#handleCancel"
                        style="-fx-background-color: transparent; -fx-text-fill: #1565C0;"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
